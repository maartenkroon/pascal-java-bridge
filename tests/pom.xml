<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.maartenkroon</groupId>
    <artifactId>pascal-java-bridge-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>pascal-java-bridge-tests</artifactId>
  <name>pascal-java-bridge tests</name>
  <description>Java test classes, generated JDemo unit and the Pascal test program. The Pascal part
    runs when the fpc.executable property is set, e.g. mvn verify -Dfpc.executable=fpc</description>

  <properties>
    <pascal.generated.dir>${project.build.directory}/generated-sources/pascal</pascal.generated.dir>
    <pascal.generated.pp.dir>${project.build.directory}/generated-sources/pascal-per-package</pascal.generated.pp.dir>
    <skipTests>false</skipTests>
  </properties>

  <!-- make the reactor build the plugin first -->
  <dependencies>
    <dependency>
      <groupId>io.github.maartenkroon</groupId>
      <artifactId>pascal-java-bridge-maven-plugin</artifactId>
      <version>${project.version}</version>
      <type>maven-plugin</type>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-install-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Generate JDemo.pas with our own plugin. Active everywhere except inside Eclipse: m2e
         cannot resolve a Maven plugin that is built in the same workspace, and always sets the
         m2e.version property. -->
    <profile>
      <id>generate-pascal</id>
      <activation>
        <property>
          <name>!m2e.version</name>
        </property>
      </activation>
      <build>
        <plugins>
          <!-- dogfooding: generate JDemo (and copy the runtime) with our own plugin, in both layouts -->
          <plugin>
            <groupId>io.github.maartenkroon</groupId>
            <artifactId>pascal-java-bridge-maven-plugin</artifactId>
            <version>${project.version}</version>
            <configuration>
              <unit>JDemo</unit>
              <includes>
                <include>demo.*</include>
                <include>java.util.ArrayList</include>
                <include>java.util.List</include>
                <include>java.util.Iterator</include>
                <include>java.lang.StringBuilder</include>
                <include>java.lang.Runnable</include>
                <include>java.lang.Throwable</include>
                <include>java.util.HashMap</include>
                <include>java.util.Map</include>
                <include>java.util.Map$Entry</include>
                <include>java.util.Comparator</include>
                <include>java.util.function.Function</include>
              </includes>
            </configuration>
            <executions>
              <!-- explicit phases: then 'mvn clean' doesn't need the (not yet built) plugin -->
              <execution>
                <id>single-unit</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <!-- also JDemoCom.pas and JDemoComServer.dpr (Delphi COM Automation) -->
                  <com>true</com>
                </configuration>
              </execution>
              <execution>
                <id>unit-per-package</id>
                <phase>process-classes</phase>
                <goals>
                  <goal>generate</goal>
                </goals>
                <configuration>
                  <unitPerPackage>true</unitPerPackage>
                  <outputDirectory>${pascal.generated.pp.dir}</outputDirectory>
                  <com>true</com>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Compile and run the Pascal tests. Activated by -Dfpc.executable=<path to fpc> -->
    <profile>
      <id>pascal-tests</id>
      <activation>
        <property>
          <name>fpc.executable</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>fpc-compile</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${fpc.executable}</executable>
                  <arguments>
                    <argument>-O2</argument>
                    <argument>-vwn</argument>
                    <argument>-Sew</argument>
                    <argument>-FU${project.build.directory}</argument>
                    <argument>-Fu${pascal.generated.dir}</argument>
                    <argument>-o${project.build.directory}/TestBindings</argument>
                    <argument>${project.basedir}/src/test/pascal/TestBindings.pas</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>pascal-test</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <executable>${project.build.directory}/TestBindings</executable>
                  <arguments>
                    <argument>--checkjni</argument>
                    <argument>--classpath</argument>
                    <argument>${project.build.outputDirectory}</argument>
                  </arguments>
                  <environmentVariables>
                    <JAVA_HOME>${java.home}</JAVA_HOME>
                  </environmentVariables>
                </configuration>
              </execution>
              <execution>
                <id>fpc-compile-per-package</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${fpc.executable}</executable>
                  <arguments>
                    <argument>-O2</argument>
                    <argument>-vwn</argument>
                    <argument>-Sew</argument>
                    <argument>-dUNIT_PER_PACKAGE</argument>
                    <argument>-FU${pascal.generated.pp.dir}</argument>
                    <argument>-Fu${pascal.generated.pp.dir}</argument>
                    <argument>-o${pascal.generated.pp.dir}/TestBindings</argument>
                    <argument>${project.basedir}/src/test/pascal/TestBindings.pas</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>pascal-test-per-package</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <executable>${pascal.generated.pp.dir}/TestBindings</executable>
                  <arguments>
                    <argument>--checkjni</argument>
                    <argument>--classpath</argument>
                    <argument>${project.build.outputDirectory}</argument>
                  </arguments>
                  <environmentVariables>
                    <JAVA_HOME>${java.home}</JAVA_HOME>
                  </environmentVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Compile and run the Pascal tests with Delphi (Windows). Activated by
         -Ddcc.executable=dcc64 (or dcc32, with a 32-bit JDK) -->
    <profile>
      <id>delphi-tests</id>
      <activation>
        <property>
          <name>dcc.executable</name>
        </property>
      </activation>
      <properties>
        <delphi.dir>${project.build.directory}/delphi</delphi.dir>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>dcc-compile</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${dcc.executable}</executable>
                  <workingDirectory>${delphi.dir}/single</workingDirectory>
                  <arguments>
                    <argument>-B</argument>
                    <argument>-Q</argument>
                    <argument>-NSSystem</argument>
                    <argument>-NU${delphi.dir}/single</argument>
                    <argument>-E${delphi.dir}/single</argument>
                    <argument>-U${pascal.generated.dir}</argument>
                    <argument>${project.basedir}/src/test/pascal/TestBindings.pas</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>delphi-test</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <executable>${delphi.dir}/single/TestBindings.exe</executable>
                  <arguments>
                    <argument>--checkjni</argument>
                    <argument>--classpath</argument>
                    <argument>${project.build.outputDirectory}</argument>
                  </arguments>
                  <environmentVariables>
                    <JAVA_HOME>${java.home}</JAVA_HOME>
                  </environmentVariables>
                </configuration>
              </execution>
              <execution>
                <id>dcc-compile-com</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${dcc.executable}</executable>
                  <workingDirectory>${delphi.dir}/single</workingDirectory>
                  <arguments>
                    <argument>-B</argument>
                    <argument>-Q</argument>
                    <argument>-NSSystem</argument>
                    <argument>-NU${delphi.dir}/single</argument>
                    <argument>-E${delphi.dir}/single</argument>
                    <argument>-U${pascal.generated.dir}</argument>
                    <argument>${project.basedir}/src/test/pascal/TestCom.pas</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>delphi-test-com</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <executable>${delphi.dir}/single/TestCom.exe</executable>
                  <arguments>
                    <argument>--checkjni</argument>
                    <argument>--classpath</argument>
                    <argument>${project.build.outputDirectory}</argument>
                  </arguments>
                  <environmentVariables>
                    <JAVA_HOME>${java.home}</JAVA_HOME>
                  </environmentVariables>
                </configuration>
              </execution>
              <execution>
                <id>dcc-compile-com-early</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${dcc.executable}</executable>
                  <workingDirectory>${delphi.dir}/single</workingDirectory>
                  <arguments>
                    <argument>-B</argument>
                    <argument>-Q</argument>
                    <argument>-NSSystem</argument>
                    <argument>-NU${delphi.dir}/single</argument>
                    <argument>-E${delphi.dir}/single</argument>
                    <argument>-U${pascal.generated.dir}</argument>
                    <argument>${project.basedir}/src/test/pascal/TestComEarly.pas</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>delphi-test-com-early</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <executable>${delphi.dir}/single/TestComEarly.exe</executable>
                  <arguments>
                    <argument>--checkjni</argument>
                    <argument>--classpath</argument>
                    <argument>${project.build.outputDirectory}</argument>
                  </arguments>
                  <environmentVariables>
                    <JAVA_HOME>${java.home}</JAVA_HOME>
                  </environmentVariables>
                </configuration>
              </execution>
              <execution>
                <!-- the generated server of JDemoCom (early binding) -->
                <id>dcc-compile-jdemo-com-server</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${dcc.executable}</executable>
                  <workingDirectory>${delphi.dir}/jdemo-comserver</workingDirectory>
                  <arguments>
                    <argument>-B</argument>
                    <argument>-Q</argument>
                    <argument>-NSSystem</argument>
                    <argument>-NU${delphi.dir}/jdemo-comserver</argument>
                    <argument>-E${delphi.dir}/jdemo-comserver</argument>
                    <argument>-U${pascal.generated.dir}</argument>
                    <argument>-I${pascal.generated.dir}</argument>
                    <argument>${pascal.generated.dir}/JDemoComServer.dpr</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>dcc-compile-com-server</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${dcc.executable}</executable>
                  <workingDirectory>${delphi.dir}/comserver</workingDirectory>
                  <arguments>
                    <argument>-B</argument>
                    <argument>-Q</argument>
                    <argument>-NSSystem</argument>
                    <argument>-NU${delphi.dir}/comserver</argument>
                    <argument>-E${delphi.dir}/comserver</argument>
                    <argument>-U${pascal.generated.dir}</argument>
                    <argument>-I${pascal.generated.dir}</argument>
                    <argument>${project.basedir}/../comserver/PascalJavaBridgeCom.dpr</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>dcc-compile-per-package</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${dcc.executable}</executable>
                  <workingDirectory>${delphi.dir}/per-package</workingDirectory>
                  <arguments>
                    <argument>-B</argument>
                    <argument>-Q</argument>
                    <argument>-NSSystem</argument>
                    <argument>-DUNIT_PER_PACKAGE</argument>
                    <argument>-NU${delphi.dir}/per-package</argument>
                    <argument>-E${delphi.dir}/per-package</argument>
                    <argument>-U${pascal.generated.pp.dir}</argument>
                    <argument>${project.basedir}/src/test/pascal/TestBindings.pas</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>delphi-test-per-package</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <executable>${delphi.dir}/per-package/TestBindings.exe</executable>
                  <arguments>
                    <argument>--checkjni</argument>
                    <argument>--classpath</argument>
                    <argument>${project.build.outputDirectory}</argument>
                  </arguments>
                  <environmentVariables>
                    <JAVA_HOME>${java.home}</JAVA_HOME>
                  </environmentVariables>
                </configuration>
              </execution>
              <execution>
                <id>dcc-compile-com-early-per-package</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${dcc.executable}</executable>
                  <workingDirectory>${delphi.dir}/per-package</workingDirectory>
                  <arguments>
                    <argument>-B</argument>
                    <argument>-Q</argument>
                    <argument>-NSSystem</argument>
                    <argument>-NU${delphi.dir}/per-package</argument>
                    <argument>-E${delphi.dir}/per-package</argument>
                    <argument>-U${pascal.generated.pp.dir}</argument>
                    <argument>${project.basedir}/src/test/pascal/TestComEarly.pas</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>delphi-test-com-early-per-package</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <executable>${delphi.dir}/per-package/TestComEarly.exe</executable>
                  <arguments>
                    <argument>--checkjni</argument>
                    <argument>--classpath</argument>
                    <argument>${project.build.outputDirectory}</argument>
                  </arguments>
                  <environmentVariables>
                    <JAVA_HOME>${java.home}</JAVA_HOME>
                  </environmentVariables>
                </configuration>
              </execution>
              <execution>
                <!-- the generated server of the per-package JDemoCom: compiled only (it has the
                     same CLSID and ProgID as the single-unit one, which the scripts test) -->
                <id>dcc-compile-jdemo-com-server-per-package</id>
                <phase>test-compile</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${dcc.executable}</executable>
                  <workingDirectory>${delphi.dir}/jdemo-comserver-per-package</workingDirectory>
                  <arguments>
                    <argument>-B</argument>
                    <argument>-Q</argument>
                    <argument>-NSSystem</argument>
                    <argument>-NU${delphi.dir}/jdemo-comserver-per-package</argument>
                    <argument>-E${delphi.dir}/jdemo-comserver-per-package</argument>
                    <argument>-U${pascal.generated.pp.dir}</argument>
                    <argument>-I${pascal.generated.pp.dir}</argument>
                    <argument>${pascal.generated.pp.dir}/JDemoComServer.dpr</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <!-- Test the COM servers (built by delphi-tests) from VBScript, JScript, PowerShell and C#:
         PascalJavaBridgeCom.dll (late binding) and the generated JDemoComServer.dll (early
         binding). It registers the DLLs for the current user (HKCU) and unregisters them
         afterwards, so it only runs on request: -Ddcc.executable=dcc64 -Dcom.scripts -->
    <profile>
      <id>com-script-tests</id>
      <activation>
        <property>
          <name>com.scripts</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>com-scripts</id>
                <phase>integration-test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipTests}</skip>
                  <executable>powershell</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${project.basedir}/src/test/script/RunComScripts.ps1</argument>
                    <argument>${project.build.directory}/delphi/comserver/PascalJavaBridgeCom.dll</argument>
                    <argument>${project.build.outputDirectory}</argument>
                    <argument>${java.home}/bin/server/jvm.dll</argument>
                    <argument>${project.build.directory}/delphi/jdemo-comserver/JDemoComServer.dll</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
